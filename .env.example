# Public configuration, included in the extension build. Never put secrets here.
VITE_APP_NAME=Tintoom
# Cloud is disabled by default, even when an API URL is present.
VITE_ENABLE_CLOUD=false
# To enable cloud explicitly, set VITE_ENABLE_CLOUD=true and a real API origin.
VITE_PALETTE_API_URL=http://localhost:3001
