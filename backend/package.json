{
  "name": "color-palette-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:mongo": "node --env-file-if-exists=.env --test tests/mongo.integration.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "openid-client": "^6.8.0",
    "helmet": "^8.1.0",
    "mongodb": "^6.20.0"
  }
}
