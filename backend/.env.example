NODE_ENV=development
PORT=3001
# Local development only. Transactions require a replica set.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=color_palette
PUBLIC_API_URL=http://localhost:3001
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Exact browser callback URLs from identity.getRedirectURL('oauth'), comma-separated.
AUTH_REDIRECT_URIS=
# Exact extension origins for allowed builds, comma-separated.
EXTENSION_ORIGINS=
# Explicit policy; no silent refresh. Choose before starting the server.
SESSION_TTL_SECONDS=86400
MAX_PALETTE_ITEMS=256
MAX_USER_PALETTES=100
TRUST_PROXY_HOPS=0
