# Staging only. Store the actual file outside the checkout, chmod 600.
# Public origin must be the real HTTPS address configured at the chosen proxy.
PUBLIC_API_URL=
# Separate persistent staging database, authenticated and using TLS.
MONGODB_URI=
MONGODB_DATABASE=color_palette_staging
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_REDIRECT_URIS=
EXTENSION_ORIGINS=
SESSION_TTL_SECONDS=86400
TRUST_PROXY_HOPS=0
STAGING_API_PORT=3001
