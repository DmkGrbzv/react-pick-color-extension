# Staging only. Store the actual file outside the checkout, chmod 600.
# Public origin must be the real HTTPS address configured at the chosen proxy.
PUBLIC_API_URL=
# Separate persistent staging database, authenticated and using TLS.
MONGODB_URI=
MONGODB_DATABASE=palette_staging
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
AUTH_REDIRECT_URIS=
EXTENSION_ORIGINS=
SESSION_TTL_SECONDS=86400
# One host Nginx proxy, matching deploy/nginx. Direct access requires 0 instead.
TRUST_PROXY_HOPS=1
# The host Nginx templates require this loopback port; do not publish it publicly.
STAGING_API_PORT=3001
