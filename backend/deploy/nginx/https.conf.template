# Included in nginx's http context (Ubuntu sites-enabled).
# Deliberately omit URI, query, headers, cookies, referrer and response Location.
log_format tintoom_staging '$time_iso8601 $remote_addr $request_method '
                          '$status $request_time $upstream_status';

server {
    listen 80;
    server_name __STAGING_DOMAIN__;
    access_log /var/log/nginx/tintoom-staging-access.log tintoom_staging;
    error_log /dev/null;

    if ($host != "__STAGING_DOMAIN__") { return 444; }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/tintoom-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / { return 308 https://__STAGING_DOMAIN__$request_uri; }
}

server {
    listen 443 ssl;
    server_name __STAGING_DOMAIN__;
    ssl_certificate /etc/letsencrypt/live/__STAGING_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__STAGING_DOMAIN__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    server_tokens off;
    access_log /var/log/nginx/tintoom-staging-access.log tintoom_staging;
    # Even ordinary upstream errors can include the original OAuth callback URL.
    # Status/timing diagnostics remain in the restricted access log above.
    error_log /dev/null;

    if ($host != "__STAGING_DOMAIN__") { return 444; }

    client_max_body_size 32k;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # One trusted host proxy. Discard client-supplied forwarding chains.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Forwarded "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        proxy_next_upstream off;
    }
}
