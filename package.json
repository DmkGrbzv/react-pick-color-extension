{
  "name": "react-pick-color-extention",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "npm run build && node scripts/packageExtension.js",
    "lint": "eslint . && npm run check:architecture",
    "preview": "vite preview",
    "test": "node --import ./tests/registerAliases.js --test --test-concurrency=1 tests/*.test.js",
    "backend:test": "npm --prefix backend test",
    "verify:extension": "node scripts/verifyExtensionBuild.js",
    "check:architecture": "node scripts/checkArchitecture.js",
    "check:frontend": "npm run lint && npm test && npm run build && npm run verify:extension",
    "format": "prettier --write . && eslint . --fix",
    "format:check": "prettier --check . && eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "i18next": "^26.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "vite": "^8.3.5"
  }
}
